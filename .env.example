# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────
POSTGRES_DB=vespay
POSTGRES_USER=vespay
POSTGRES_PASSWORD=vespay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (cache / broker / channels) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Ejecuta las tareas inline (sin worker). Déjalo vacío/False si usas el worker de docker-compose.
CELERY_TASK_ALWAYS_EAGER=False

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Encriptación de credenciales (AES-256-GCM) ───────────────────────────
# Generar con: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VESPAY_ENCRYPTION_KEY=

# ── Terceros (placeholders de desarrollo) ────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
